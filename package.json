{
  "name": "metro-launcher",
  "version": "0.1.0",
  "description": "A faithful Windows 8 Metro Start Screen recreation for Windows 11",
  "productName": "Metro Launcher",
  "main": "out/main/index.js",
  "author": "Metro Launcher",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "package": "npm run build && electron-builder --config electron-builder.config.json",
    "package:portable": "npm run build && electron-packager . --platform=win32 --arch=x64 --out=release --overwrite --ignore=\"^/release($|/)\" --ignore=\"^/src($|/)\""
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "fuse.js": "^7.0.0",
    "winreg": "^1.2.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@electron/packager": "^18.3.6",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/winreg": "^1.2.36",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0",
    "vite": "^5.3.0"
  }
}
